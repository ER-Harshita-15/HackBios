# NETRA-X Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://netrax:netrax_secret@localhost:5432/netrax_db
DATABASE_URL_SYNC=postgresql://netrax:netrax_secret@localhost:5432/netrax_db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# OCR
OCR_ENABLED=true

# NLP / NER
NER_MODEL=en_core_web_sm
# Options: en_core_web_sm, en_core_web_md, en_core_web_lg, en_core_web_trf

# LLM (Optional - system works without this)
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Security
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Processing
BACKGROUND_WORKERS=2
